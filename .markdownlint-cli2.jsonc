// markdownlint-cli2 config — see https://github.com/DavidAnson/markdownlint-cli2
{
  "globs": ["**/*.md"],
  // .claude/worktrees/ holds a full checkout per isolated agent session; it is
  // gitignored (so Prettier skips it) but cli2 does not read .gitignore. The
  // same goes for test-results/ and playwright-report/: a failed `npm test`
  // leaves an error-context.md there, which failed the next validate
  // (2026-11-05).
  "ignores": ["node_modules", ".superpowers", ".playwright-mcp", ".claude/worktrees", "test-results", "playwright-report"],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD036": false,
    "MD041": false,
  },
}
