{
  "name": "dealeron-slider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/auto.js --bundle --format=iife --target=es2020 --outfile=dist/do-slider.js && esbuild src/auto.js --bundle --format=iife --minify --target=es2020 --outfile=dist/do-slider.min.js && esbuild src/dealeron-slider.css --outfile=dist/do-slider.css && esbuild src/dealeron-slider.css --minify --outfile=dist/do-slider.min.css && node scripts/build-cards.mjs && node scripts/build-patterns.mjs && node scripts/build-vendor.mjs",
    "size": "npm run build && node scripts/size.mjs",
    "serve": "esbuild --servedir=. --serve=127.0.0.1:8137",
    "lint:css": "npx stylelint \"src/**/*.css\" \"demo/assets/*.css\"",
    "lint:css:fix": "npx stylelint \"src/**/*.css\" \"demo/assets/*.css\" --fix",
    "lint:js": "npx eslint \"*.{js,mjs}\" \"src/**/*.js\" \"demo/assets/**/*.js\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.mjs\" --max-warnings=0",
    "lint:js:fix": "npx eslint \"*.{js,mjs}\" \"src/**/*.js\" \"demo/assets/**/*.js\" \"scripts/**/*.mjs\" \"scripts/**/*.js\" \"tests/**/*.mjs\" --fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "check:looks": "node scripts/check-looks.mjs",
    "check:vendor": "node scripts/build-vendor.mjs --check",
    "check:ci": "node scripts/check-ci.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "lint:css:generated": "node scripts/lint-generated-css.mjs",
    "test": "playwright test --project=chromium",
    "test:browsers": "playwright test --project=firefox --project=webkit",
    "test:sr": "playwright test -c playwright.sr.config.mjs",
    "test:ui": "playwright test --ui",
    "a11y": "node scripts/a11y.mjs",
    "export:lovable": "node scripts/export-lovable.mjs",
    "validate": "npm run lint:css && npm run lint:css:generated && npm run lint:js && npm run lint:md && npm run format:check && npm run check:looks && npm run check:vendor && npm run check:ci && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@guidepup/guidepup": "^0.40.0",
    "@guidepup/playwright": "^0.21.0",
    "@playwright/test": "^1.64.1",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^26.6.6",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "markdownlint-cli2": "^0.24.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tweakpane": "^4.0.5",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild": false
  },
  "overrides": {
    "katex": "^0.19.0",
    "minimatch": "^11.0.4",
    "re2js": "^2.9.1",
    "smol-toml": "^1.9.0"
  }
}
